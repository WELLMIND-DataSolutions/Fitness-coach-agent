# Copy to .env and fill in. Never commit .env.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional
# DATABASE_URL=postgresql://user:pass@host/db   # default: local SQLite file
# CORS_ORIGINS=http://localhost:5173             # comma-separated allowed web origins
# RUN_REMINDER_WORKER_IN_API=true                # run reminders inside the API (single-service hosting)
# DEFAULT_TIMEZONE=UTC
# LOG_LEVEL=INFO